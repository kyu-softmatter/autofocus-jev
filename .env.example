# Create an API key at https://console.typesafe.ai/ and keep the real value in .env.
TYPESAFE_API_KEY=replace-with-your-api-key

# Pin the calibrated model instead of using the moving jev-latest alias.
TYPESAFE_MODEL=jev-1.13.0

# Micro-Manager device adapters and the hardware configuration are machine-specific.
MM_DEVICE_ADAPTER_PATH=/path/to/Micro-Manager
MM_CONFIG_PATH=/path/to/MMConfig.cfg
